# Server & Frontend Ports
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/app.db

# Amazon Simple Email Service (AWS SES) Configuration
# Leave blank or omit to automatically use the in-memory MockEmailSender for development/testing
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Default Verified Sender Email Address (used when no sender email is manually entered in the campaign form)
SES_FROM_EMAIL=
